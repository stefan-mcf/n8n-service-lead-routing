    {
      "id": "normalize-intake",
      "name": "Normalize Intake",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -760,
        -40
      ],
      "parameters": {
        "jsCode": "const raw = $json;\nconst text = (value) => String(value ?? '').trim();\nconst email = text(raw.email).toLowerCase();\nconst phone = text(raw.phone).replace(/\\D/g, '');\nconst service = text(raw.service).toLowerCase();\nconst customerName = text(raw.customer_name);\nconst eventId = text(raw.event_id) || `FORM-${Date.now()}`;\nconst consentRaw = raw.consent_to_contact;\nconst consent = Array.isArray(consentRaw) ? consentRaw.length > 0 : Boolean(consentRaw);\nconst errors = [];\nif (!customerName) errors.push('customer_name_required');\nif (!email && !phone) errors.push('email_or_phone_required');\nif (!service) errors.push('service_required');\nif (!text(raw.postcode)) errors.push('postcode_required');\nif (!consent) errors.push('contact_consent_required');\nconst contactKey = email || phone || 'no-contact';\nreturn [{ json: {\n  ...raw,\n  event_id: eventId,\n  customer_name: customerName,\n  email,\n  phone,\n  service,\n  source: text(raw.source) || 'website_quote_form',\n  correlation_id: eventId.toLowerCase(),\n  duplicate_key: `${contactKey}|${service || 'no-service'}`,\n  errors,\n  is_invalid: errors.length > 0,\n  needs_human_review: service.includes('electrical') || service.includes('regulated'),\n  has_integration_exception: Boolean(raw.simulate_adapter_failure),\n  external_actions_performed: false\n} }];"
      }
    },
